{
  "schema": "idelium.test-import.v1",
  "name": "Idelium demo full component coverage",
  "description": "Open https://idelium.org/demo/ and exercise every component family exposed by the demo page with stable data-testid selectors.",
  "steps": [
    {
      "name": "Open Idelium demo page",
      "failedExit": true,
      "attachScreenshot": true,
      "steps": [
        {
          "stepType": "open_browser",
          "url": "https://idelium.org/demo/",
          "xpath": "//*",
          "note": "Open the Idelium demo page"
        },
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": "[data-testid='selenium-demo-page']",
          "waitCondition": "visibility",
          "waitSeconds": 15,
          "note": "Verify the main demo page container is visible"
        }
      ]
    },
    {
      "name": "Verify hero, logo and console summary",
      "failedExit": true,
      "attachScreenshot": true,
      "steps": [
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": "[data-testid='demo-logo-link']",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the logo link is visible"
        },
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": "[data-testid='demo-logo']",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the logo image is visible"
        },
        {
          "stepType": "wait_for_next_step",
          "findBy": "xpath",
          "target": "//h1[contains(., 'Idelium Demo Lab')]",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the hero title is visible"
        },
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": "[data-testid='capability-form']",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the Forms capability badge is visible"
        },
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": "[data-testid='capability-waits']",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the Waits capability badge is visible"
        },
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": "[data-testid='capability-iframe']",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the iframe capability badge is visible"
        },
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": "[data-testid='capability-shadow']",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the Shadow DOM capability badge is visible"
        },
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": "[data-testid='demo-console']",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the demo console summary is visible"
        }
      ]
    },
    {
      "name": "Exercise form controls",
      "failedExit": true,
      "attachScreenshot": true,
      "steps": [
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": "[data-testid='demo-form']",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the form container is visible"
        },
        {
          "stepType": "write",
          "findBy": "css",
          "target": "[data-testid='name-input']",
          "text": "Ada Lovelace",
          "note": "Write the demo name"
        },
        {
          "stepType": "write",
          "findBy": "css",
          "target": "[data-testid='email-input']",
          "text": "ada@example.org",
          "note": "Write the demo email"
        },
        {
          "stepType": "select",
          "findBy": "css",
          "target": "[data-testid='role-select']",
          "selectType": "value",
          "value": "qa",
          "note": "Select the QA role"
        },
        {
          "stepType": "click",
          "findBy": "css",
          "target": "[data-testid='target-web-radio']",
          "note": "Select the web automation target"
        },
        {
          "stepType": "click",
          "findBy": "css",
          "target": "[data-testid='target-api-radio']",
          "note": "Select the API automation target"
        },
        {
          "stepType": "click",
          "findBy": "css",
          "target": "[data-testid='target-mobile-radio']",
          "note": "Select the mobile automation target"
        },
        {
          "stepType": "click",
          "findBy": "css",
          "target": "[data-testid='terms-checkbox']",
          "note": "Accept the demo terms"
        },
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": "[data-testid='priority-range']",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the priority range input is visible"
        },
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": "[data-testid='priority-value']",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the priority value label is visible"
        },
        {
          "stepType": "write",
          "findBy": "css",
          "target": "[data-testid='notes-textarea']",
          "text": "Full Idelium demo coverage generated from the native JSON import.",
          "note": "Write notes in the textarea"
        },
        {
          "stepType": "click",
          "findBy": "css",
          "target": "[data-testid='submit-button']",
          "note": "Submit the demo form"
        }
      ]
    },
    {
      "name": "Exercise dynamic content, tabs, modal, alert and toast",
      "failedExit": true,
      "attachScreenshot": true,
      "steps": [
        {
          "stepType": "click",
          "findBy": "css",
          "target": "[data-testid='load-delayed-button']",
          "note": "Trigger the delayed content area"
        },
        {
          "stepType": "sleep",
          "seconds": 2,
          "note": "Wait for delayed content to render"
        },
        {
          "stepType": "click",
          "findBy": "css",
          "target": "[data-testid='toggle-hidden-button']",
          "note": "Reveal the hidden panel"
        },
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": "[data-testid='hidden-panel']",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the hidden panel is visible"
        },
        {
          "stepType": "click",
          "findBy": "css",
          "target": "[data-testid='tab-overview']",
          "note": "Open the Overview tab"
        },
        {
          "stepType": "click",
          "findBy": "css",
          "target": "[data-testid='tab-details']",
          "note": "Open the Details tab"
        },
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": "[data-testid='tab-panel']",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the tab panel is visible"
        },
        {
          "stepType": "click",
          "findBy": "css",
          "target": "[data-testid='tab-logs']",
          "note": "Open the Logs tab"
        },
        {
          "stepType": "click",
          "findBy": "css",
          "target": "[data-testid='open-modal-button']",
          "note": "Open the demo modal"
        },
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": ".demo-modal",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the demo modal is visible"
        },
        {
          "stepType": "selenium_command",
          "operation": "execute_script",
          "script": "const modal = document.querySelector('.demo-modal'); if (modal) { const button = modal.querySelector('button'); if (button) { button.click(); } else { modal.remove(); } }",
          "note": "Close the demo modal"
        },
        {
          "stepType": "click",
          "findBy": "css",
          "target": "[data-testid='native-alert-button']",
          "note": "Open the native browser alert"
        },
        {
          "stepType": "selenium_command",
          "operation": "accept_alert",
          "note": "Accept the native browser alert"
        },
        {
          "stepType": "click",
          "findBy": "css",
          "target": "[data-testid='show-toast-button']",
          "note": "Show the toast notification"
        },
        {
          "stepType": "wait_for_next_step",
          "findBy": "css",
          "target": ".demo-toast",
          "waitCondition": "visibility",
          "waitSeconds": 10,
          "note": "Verify the toast notification is visible"
        }
      ]
    },
    {
